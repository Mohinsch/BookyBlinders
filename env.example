# ==========================================
# 🐘 PostgreSQL Database (Docker Configuration)
# ==========================================
POSTGRES_USER=admin_user
POSTGRES_PASSWORD=secure_dev_password
POSTGRES_DB=booky_blinders_dev

# ==========================================
# 🔗 Database Connection String
# ==========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: HOST is 'db' when running inside Docker, 'localhost' for local execution
DATABASE_URL=postgresql://admin_user:secure_dev_password@db:5432/booky_blinders_dev

# ==========================================
# 🔐 Authentication (Better-Auth)
# ==========================================
# Generate a secure string: openssl rand -base64 32
BETTER_AUTH_SECRET=your_generated_secret_here
BETTER_AUTH_URL=http://localhost:3000

# ==========================================
# 🌍 Application
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3000

# ==========================================
# 📖 Google Books API
# ==========================================
# 1. Go to https://console.cloud.google.com/
# 2. Enable "Books API" and create an API Key
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# ==========================================
# 📝 Optional: Cloud Database (e.g., Supabase, Neon)
# ==========================================
# Uncomment and replace to use an external database instead of local Docker
# DATABASE_URL="postgresql://user:password@host:port/postgres"